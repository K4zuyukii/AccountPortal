@model AccountPortal.Models.User
@{
    ViewData["Title"] = "My account";
}

<section class="auth auth-wide">
    <header class="auth-header">
        <div class="avatar">@Model.Initials</div>
        <h1>Welcome back, @Model.FirstName</h1>
        <p>Here is your account information.</p>
    </header>

    <span class="card-tab">Account information</span>

    <div class="card-panel">
        <dl class="details">
            <div class="row">
                <dt class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 6.5 8.5 7 8.5-7"></path></svg>
                    Email Address
                </dt>
                <dd class="value">@Model.Email</dd>
            </div>
            <div class="row">
                <dt class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"></path></svg>
                    Phone Number
                </dt>
                <dd class="value">@(string.IsNullOrEmpty(Model.Phone) ? "Not provided" : Model.Phone)</dd>
            </div>
            <div class="row">
                <dt class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7Zm-2 8h14v10H5V10Z"></path></svg>
                    Member Since
                </dt>
                <dd class="value">@Model.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy")</dd>
            </div>
            <div class="row">
                <dt class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.6-4.6 1.4 1.4-6 6Z"></path></svg>
                    Account Status
                </dt>
                <dd class="value">Active</dd>
            </div>
        </dl>

        <div class="logout">
            <form asp-action="Logout" asp-controller="Account" method="post">
                <button type="submit" class="btn-navy btn-inline">Log Out</button>
            </form>
        </div>
    </div>
</section>
