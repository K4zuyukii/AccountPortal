@model SignupViewModel
@{
    ViewData["Title"] = "Create an account";
}

<section class="auth">
    <header class="auth-header">
        <h1>Create an account</h1>
        <p>Fill in your details to get started.</p>
    </header>

    <span class="card-tab">User information</span>

    <div class="card-panel">
        <form asp-action="Signup" asp-controller="Account" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert" role="alert"></div>

            <div class="row">
                <label asp-for="Name" class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z"></path></svg>
                    Full Name
                </label>
                <div class="row-field">
                    <input asp-for="Name" class="field-input" placeholder="Johnny Perlas" autocomplete="name" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>
            </div>

            <div class="row">
                <label asp-for="Phone" class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"></path></svg>
                    Phone Number
                </label>
                <div class="row-field">
                    <input asp-for="Phone" class="field-input" placeholder="09683712070" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>
            </div>

            <div class="row">
                <label asp-for="Email" class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 6.5 8.5 7 8.5-7"></path></svg>
                    Email Address
                </label>
                <div class="row-field">
                    <input asp-for="Email" class="field-input" placeholder="johnnyperlas@gmail.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
            </div>

            <div class="row">
                <label asp-for="Password" class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 9V7a5 5 0 0 0-10 0v2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2Zm-8-2a3 3 0 0 1 6 0v2H9V7Z"></path></svg>
                    Password
                </label>
                <div class="row-field">
                    <input asp-for="Password" class="field-input" placeholder="At least 6 characters" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
            </div>

            <div class="row">
                <label asp-for="ConfirmPassword" class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 9V7a5 5 0 0 0-10 0v2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2Zm-8-2a3 3 0 0 1 6 0v2H9V7Z"></path></svg>
                    Confirm Password
                </label>
                <div class="row-field">
                    <input asp-for="ConfirmPassword" class="field-input" placeholder="Re-enter password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn-navy">Create Account</button>
        </form>

        <p class="switch">Already have an account? <a asp-action="Login" asp-controller="Account">Log in</a></p>
    </div>
</section>
