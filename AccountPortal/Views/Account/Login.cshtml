@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<section class="auth">
    <header class="auth-header">
        <h1>Welcome back</h1>
        <p>Log in to view your account information.</p>
    </header>

    <span class="card-tab">Log in</span>

    <div class="card-panel">
        <form asp-action="Login" asp-controller="Account" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert" role="alert"></div>

            <div class="row">
                <label asp-for="Email" class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 6.5 8.5 7 8.5-7"></path></svg>
                    Email Address
                </label>
                <div class="row-field">
                    <input asp-for="Email" class="field-input" placeholder="johnnyperlas@gmail.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
            </div>

            <div class="row">
                <label asp-for="Password" class="row-label">
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 9V7a5 5 0 0 0-10 0v2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2Zm-8-2a3 3 0 0 1 6 0v2H9V7Z"></path></svg>
                    Password
                </label>
                <div class="row-field">
                    <input asp-for="Password" class="field-input" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn-navy">Log In</button>
        </form>

        <p class="switch">Don't have an account? <a asp-action="Signup" asp-controller="Account">Sign up</a></p>
    </div>
</section>
